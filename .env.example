# Copy to .env.aws.local AFTER teammate deployment; use actual stack outputs.
# Every VITE_ value is public. Never add keys, passwords, tokens, or client secrets.
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_ISSUER=
VITE_API_URL=
VITE_AUTH_SCOPE=
VITE_AUTH_CALLBACK_URL=
VITE_AUTH_LOGOUT_URL=
# Optional local-only port (default 3000). Keep deployed FrontendOrigin in sync.
DEV_PORT=3000
